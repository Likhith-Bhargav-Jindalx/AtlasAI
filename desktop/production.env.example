# Copy this file to desktop/production.env and fill in real values before
# running desktop/build.sh. That file is baked directly into the exe
# bundle (gitignored — never commit real credentials here) so every
# double-clicked copy of the exe connects straight to production Postgres
# and Blob Storage, with no backend to deploy.
ATLAS_DATABASE_URL=postgresql+psycopg://user:password@your-server.postgres.database.azure.com:5432/atlas?sslmode=require
ATLAS_SESSION_SECRET=replace-with-a-long-random-value
ATLAS_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
ATLAS_AZURE_STORAGE_CONTAINER=atlas-runs
ATLAS_REQUIRE_AZURE_STORAGE=true
