# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is loaded automatically:
#   - ATLAS_DATABASE_URL / ATLAS_RUN_ROOT / ATLAS_SESSION_SECRET via
#     atlas_engine.config.Settings (pydantic-settings' built-in .env support)
#   - The ATLAS_AZURE_OPENAI_* / AZURE_OPENAI_* vars below via
#     atlas_engine.llm.factory.create_llm_client (python-dotenv)
# Real exported shell env vars always take precedence over this file.
# Never commit the actual `.env` file — it's already covered by .gitignore's
# generic env-file pattern, but double-check before committing secrets.

# --- Database (defaults shown match the docker-compose dev Postgres) ---
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_password@localhost:5434/atlas

# --- Where recordings/videos/codegen scripts/golden scripts are stored on disk ---
# ATLAS_RUN_ROOT=/Users/you/.atlas/runs

# --- Session cookie signing secret — set a real random value outside of local dev ---
# ATLAS_SESSION_SECRET=change-me-to-something-random

# --- Azure OpenAI — powers the brain's self-heal repair (brain/repair.py::think()) ---
# Without these three set, create_llm_client() returns None: authoring/heal runs
# still replay and detect drift, they just can't repair an off-track step with an
# LLM (cache-based repair from a prior successful run still works either way).
ATLAS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
ATLAS_AZURE_OPENAI_API_KEY=your-api-key
ATLAS_AZURE_OPENAI_MODEL=your-deployment-name

# Also accepted (aliases, for parity with the previous codebase's env vars):
# AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY / AZURE_OPENAI_MODEL
# AZURE_OPENAI_DEPLOYMENT / AZURE_OPENAI_DEPLOYMENT_NAME
